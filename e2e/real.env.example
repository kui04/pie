# Copy this file to e2e/.testenv/real.env and fill it in.
#
# The file is ignored by git. The key is written to a Docker secret for the
# test host; it never enters the image, the app, or a log.
#
# PIE_E2E_PROVIDER  a pi provider id: openrouter, anthropic, or an id of your own
# PIE_E2E_MODEL     the model id the endpoint accepts
# PIE_E2E_THINKING  off, minimal, low, medium, high, xhigh, or max; use a level
#                   the model supports
# PIE_E2E_API_KEY   the key, in single quotes if it holds shell characters;
#                   leave it empty for a custom endpoint that takes none
#
# For a custom OpenAI-compatible endpoint, also set PIE_E2E_BASE_URL. Leave the
# URL empty to use a built-in provider.
#
# PIE_E2E_BASE_URL        https://example.com/v1
# PIE_E2E_API             openai-completions, openai-responses, or anthropic-messages
# PIE_E2E_REASONING       1 when the model supports thinking
# PIE_E2E_VISION          1 when the model accepts images
# PIE_E2E_MODEL_NAME      the name the picker shows; defaults to the model id
# PIE_E2E_CONTEXT_WINDOW  128000
# PIE_E2E_MAX_TOKENS      16384

PIE_E2E_PROVIDER=openrouter
PIE_E2E_MODEL=
PIE_E2E_THINKING=low
PIE_E2E_API_KEY=
PIE_E2E_BASE_URL=
