{
    "name": "pie",
    "private": true,
    "version": "1.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "tauri": "tauri",
        "app:dev": "tauri dev",
        "app:build": "tauri build",
        "android:dev": "tauri android dev",
        "android:build": "tauri android build --target aarch64 --apk",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "check": "cd src-tauri && cargo check",
        "clippy": "cd src-tauri && cargo clippy --all-targets -- -D warnings",
        "doc": "cd src-tauri && RUSTDOCFLAGS=\"-D warnings\" cargo doc --no-deps",
        "rust-test": "cd src-tauri && cargo test",
        "ssh-fixture": "bash src-tauri/tests/scripts/ssh-fixture.sh start",
        "ssh-test": "eval \"$(bash src-tauri/tests/scripts/ssh-fixture.sh start)\" && cd src-tauri && cargo test --test ssh --test session -- --ignored --test-threads=1",
        "ui-check": "bash scripts/ui-check.sh",
        "hooks": "prek run --all-files"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@fontsource-variable/ibm-plex-sans": "^5.3.0",
        "@fontsource/ibm-plex-mono": "^5.3.0",
        "@fontsource/ibm-plex-serif": "^5.3.0",
        "@shadcn/react": "^0.3.1",
        "@tanstack/react-query": "^5.104.1",
        "@tauri-apps/api": "^2",
        "@xstate/react": "^6.1.0",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.4.0",
        "katex": "^0.16.47",
        "lucide-react": "^1.49.0",
        "motion": "^14.0.0",
        "next-themes": "^0.4.6",
        "pathe": "^2.0.3",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-markdown": "^10.1.0",
        "react-router": "^8.4.0",
        "rehype-katex": "^7.0.1",
        "remark-breaks": "^4.0.0",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0",
        "shiki": "^4.5.0",
        "sonner": "^2.0.8",
        "virtua": "^0.53.2",
        "xstate": "^5.33.2",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@earendil-works/pi-ai": "1.1.0",
        "@earendil-works/pi-coding-agent": "1.1.0",
        "@eslint/js": "^10.0.1",
        "@storybook/addon-a11y": "^10.6.1",
        "@storybook/addon-docs": "^10.6.1",
        "@storybook/react-vite": "^10.6.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tauri-apps/cli": "^2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^26.6.3",
        "@types/react": "^19.1.8",
        "@types/react-dom": "^19.1.6",
        "@vitejs/plugin-react": "^6.0.2",
        "@xstate/graph": "^3.0.4",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-better-tailwindcss": "^4.9.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.12.0",
        "happy-dom": "^20.14.5",
        "prettier": "^3.9.9",
        "shadcn": "^4.22.0",
        "storybook": "^10.6.1",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.0.16",
        "vitest": "^5.0.3"
    }
}
